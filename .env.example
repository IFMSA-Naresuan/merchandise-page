# -----------------------------------------------------------------------------
# Google Sheets Integration Settings
# -----------------------------------------------------------------------------

# Spreadsheet ID from the Google Sheet URL
# e.g. https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID="YOUR_SPREADSHEET_ID_HERE"

# Service Account Email connected to the Google Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL="merch-catalog-reader@project-07cd9b1e-82c4-4b1f-bf3.iam.gserviceaccount.com"

# -----------------------------------------------------------------------------
# Option A: Production Authentication (Vercel + GCP Workload Identity Pool)
# Keyless - No private key required in production!
# -----------------------------------------------------------------------------
# GCP_WORKLOAD_IDENTITY_PROVIDER="projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID"

# -----------------------------------------------------------------------------
# Option B: Local Development Authentication (.env.local)
# Used when running `npm run dev` locally
# -----------------------------------------------------------------------------
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
